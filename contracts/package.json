{
  "name": "shooty-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Fixed-entry Shooty escrow for Monad Testnet",
  "scripts": {
    "build": "forge build && node tools/export-abi.mjs",
    "test": "forge test",
    "test:integration": "node --test --test-isolation=none test/*.test.mjs",
    "test:gas": "forge test --isolate --match-contract ShootyArenaGasTest",
    "prepare:deployment": "node tools/prepare-deployment.mjs",
    "export:verification": "node tools/export-verification.mjs",
    "deploy:testnet": "node --env-file=.env tools/deploy-testnet.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0"
  }
}
